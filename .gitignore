# =============================================
# iHeart Recorder — .gitignore
# =============================================

# ----- Secrets & Credentials -----
client_secrets.json
token.json
*.pem
*.key
.env
.env.*

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ----- Virtual Environments -----
.venv/
venv/
env/
.input/

# ----- Audio Files (large binaries) -----
*.wav
*.mp3
*.flac
*.ogg

# ----- Logs -----
*.log

# ----- IDE & Editor -----
.cursor/
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Binaries & Installers -----
chrome-win64/
chromedriver.exe
ffmpeg/
bfg.jar
*.whl
*.exe
*.7z
*.zip
*.rar

# ----- Backup & Build Artifacts -----
backup/

# ----- Test & Debug Output -----
test_output*.txt
diagnostic_buttons.log
batch_run*.log
mission.log

# ----- Browser Profiles -----
.edge-profile-iheart/
